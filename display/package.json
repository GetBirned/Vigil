{
  "name": "vigil-display",
  "private": true,
  "version": "0.1.0",
  "description": "Radar-scope display for the Vigil tracker: UDP-to-WebSocket gateway plus a React PPI scope",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c cyan,magenta \"npm:gateway\" \"vite\"",
    "gateway": "tsx server/gateway.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/gateway.ts --static dist",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  }
}
